{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "App",
  "extends": "./base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "noEmit": true,
    "allowJs": false
  },
  "include": ["src/**/*", "app/**/*", "*.config.ts", "*.config.js"]
}
