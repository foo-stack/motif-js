{
  "name": "@motif-js/core",
  "version": "0.0.0",
  "description": "Engine, tokens, theme, runtime types — the foundation of motif-js.",
  "homepage": "https://github.com/foo-stack/motif-js/tree/main/packages/core#readme",
  "bugs": "https://github.com/foo-stack/motif-js/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/foo-stack/motif-js.git",
    "directory": "packages/core"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "react-native": "./dist/index.native.js",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo *.tsbuildinfo",
    "test": "vitest run"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}
