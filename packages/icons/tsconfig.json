{
  "extends": "@usemotif/tsconfig/react-library.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    // The icons.test.tsx uses node:fs / node:path / node:url to walk
    // the generated glyph files for assertions. These imports require
    // node typings — opting in just for this package to keep the
    // shared react-library tsconfig dom-only.
    "types": ["react", "node"]
  },
  "include": ["src/**/*"]
}
