{
  "name": "@usemotif/compiler-swc",
  "version": "1.2.1",
  "description": "Deprecated alias for @usemotif/compiler-web — this plugin is Babel-via-unplugin, never SWC. Import from @usemotif/compiler-web instead.",
  "homepage": "https://github.com/foo-stack/usemotif/tree/main/packages/compiler-swc#readme",
  "bugs": "https://github.com/foo-stack/usemotif/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/foo-stack/usemotif.git",
    "directory": "packages/compiler-swc"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.*",
    "!src/**/*.spec.*",
    "!src/**/__tests__/**",
    "!src/**/__fixtures__/**"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@usemotif/compiler-web": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^6.0.3"
  }
}
