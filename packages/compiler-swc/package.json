{
  "name": "@usemotif/compiler-swc",
  "version": "1.0.0",
  "description": "Universal bundler plugin (unplugin) for motif-js static style extraction — Babel-based; works with Vite, Rollup, webpack, Rspack, esbuild, and Farm.",
  "homepage": "https://github.com/foo-stack/usemotif/tree/main/packages/compiler-swc#readme",
  "bugs": "https://github.com/foo-stack/usemotif/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/foo-stack/usemotif.git",
    "directory": "packages/compiler-swc"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo *.tsbuildinfo",
    "test": "vitest run"
  },
  "dependencies": {
    "@babel/core": "^7.29.0",
    "@usemotif/compiler-babel": "workspace:*",
    "unplugin": "^3.0.0"
  },
  "devDependencies": {
    "@types/babel__core": "^7.20.5",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}
