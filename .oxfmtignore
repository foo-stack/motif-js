# Next regenerates this on every build; let it own the formatting.
apps/*/next-env.d.ts

# oxfmt collapses indentation inside multi-line JS template literals that
# sit on JSX attributes (e.g. <CodeBlock code={`…`}>). The code samples in
# these MDX files are user-facing and must keep their authored indentation.
apps/docs/content/**/*.mdx
