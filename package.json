{
  "name": "motif-js",
  "version": "0.0.0",
  "private": true,
  "description": "Cross-platform React styling library for web, React Native, and desktop.",
  "homepage": "https://github.com/foo-stack/motif-js#readme",
  "bugs": "https://github.com/foo-stack/motif-js/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/foo-stack/motif-js.git"
  },
  "workspaces": [
    "packages/*",
    "apps/*",
    "tooling/*",
    "examples/*",
    "e2e/*",
    "benchmarks/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "clean": "turbo run clean && rm -rf node_modules .turbo",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "yarn build && changeset publish",
    "release:local": "node scripts/publish.mjs",
    "size": "node scripts/check-sizes.mjs",
    "size:update": "node scripts/check-sizes.mjs --update",
    "treeshake": "node scripts/check-tree-shaking.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "oxfmt": "^0.46.0",
    "oxlint": "^1.61.0",
    "tsup": "^8.5.1",
    "turbo": "^2.9.6",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  },
  "resolutions": {
    "react-native": "0.83.6"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "yarn@4.13.0"
}
