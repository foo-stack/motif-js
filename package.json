{
  "name": "motif-js",
  "version": "0.0.0",
  "private": true,
  "description": "Cross-platform React styling library for web, React Native, and desktop.",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "apps/*",
    "tooling/*",
    "examples/*",
    "e2e/*",
    "benchmarks/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "clean": "turbo run clean && rm -rf node_modules .turbo"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "oxfmt": "^0.46.0",
    "oxlint": "^1.61.0",
    "tsup": "^8.5.1",
    "turbo": "^2.9.6",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "yarn@4.13.0"
}
