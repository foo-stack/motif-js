# Dependencies
node_modules/
.pnp.*

# Yarn 4 (with nodeLinker: node-modules) — keep cache out of git
.yarn/cache/
.yarn/install-state.gz
.yarn/build-state.yml
.yarn/unplugged/

# Build outputs
dist/
build/
.turbo/
.vorge/
*.tsbuildinfo
.next/
storybook-static/
.expo/
.react-router/
out/

# Test outputs
coverage/
.vitest/

# Lighthouse audit outputs (run-local)
.lighthouse/
*.report.html
*.report.json

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS / editor
.DS_Store
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
*.swp

# Claude Code per-session runtime state
.claude/

# docwright agent state (local-only; do not ship).
# Exceptions at the repo root: durable contracts the docs system relies
# on across sessions. Voice card + final IA + Tamagui reference are
# project artefacts, not runtime scratch — they get committed so a
# fresh clone can rebuild the docs without re-running discovery.
/.docwright/*
!/.docwright/voice-card.md
!/.docwright/final-ia.md
!/.docwright/tamagui-reference.md
# Anywhere deeper in the tree, .docwright/ is purely agent scratch.
apps/**/.docwright/
packages/**/.docwright/

# Env
.env
.env.local
.env.*.local

# Native
ios/Pods/
android/.gradle/

# Local-only analysis docs (not for the repo)
INSIGHTS.md
TODO.md
PLAN.md
PROGRESS.md
LAST_MEMORY.md

# AI-collaboration scratch — planning, progress, handoff notes
PLAN.md
PROGRESS.md
LAST_MEMORY.md
*.handoff.md

# Playwright per-run artifacts (NOT __visual__/baseline/, that's the gate)
apps/docs/test-results/
apps/docs/playwright-report/
apps/uikit/test-results/
apps/uikit/playwright-report/
examples/desktop-electron/test-results/
examples/desktop-electron/playwright-report/

# Comparison-spec baselines reference a local-only prototype path; not portable.
apps/docs/__visual__/baseline/comparison/
