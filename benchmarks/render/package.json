  "private": true,
  "description": "Render-heavy benchmarks for motif-js: runtime vs compiled vs vanilla.",
  "type": "module",
  "scripts": {
    "bench": "vitest bench --run",
    "bench:report": "vitest bench --run --reporter=verbose",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@stitches/react": "^1.2.8",
    "@tamagui/config": "^1.123.3",
    "@tamagui/core": "^1.123.3",
    "@usemotif/core": "workspace:*",
    "@usemotif/react": "workspace:*",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}
